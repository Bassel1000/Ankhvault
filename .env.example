# Supabase Cloud Project Configuration
# Copy this file to .env and fill in your values from:
# https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side only (never expose this in frontend code)
# Required for the Express API server (server.js) to write to Supabase
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
