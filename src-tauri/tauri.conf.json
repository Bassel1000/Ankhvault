{
  "$schema": "https://schema.tauri.app/config/2.0.0.json",
  "productName": "Ankhvault",
  "version": "1.0.3",
  "identifier": "io.ankhvault.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ankhvault - Game Store & Launcher",
        "width": 1360,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "WebView2Loader.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2MUU5Q0VFODAwRUJCRTMKUldUanV3NkE3cHdlOXZzYUZTZlNSOFRzK2dwZTRXSTUyOGFFZGpKajJORG9qS2t6c3h6MDVOR3UK",
      "endpoints": [
        "https://github.com/Duat-Studio/Ankhvault/releases/latest/download/latest.json"
      ]
    }
  }
}
